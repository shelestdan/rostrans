---
import BaseLayout from "../layouts/BaseLayout.astro";
import { company, mapUrl, siteUrl } from "../lib/site";

const title = "РУТРАНС - перевозка спецтехники, оборудования и негабаритных грузов по России";
const description =
  "ООО «РУТРАНС» перевозит спецтехнику, оборудование, контейнеры, металлоконструкции и коммерческие грузы по РФ. Расчет за 15 минут, до 100 тонн, НДС.";
const withBase = (path: string) => `${import.meta.env.BASE_URL}${path.replace(/^\//, "")}`;
const leadAction = withBase("/lead.php");
const privacyUrl = withBase("/privacy/");
const heroImage = withBase("/assets/rutrans-hero-port-truck.png");
const maxUrl = "https://max.ru/u/f9LHodD0cOKkLtxDDzsN0-8HMsANd_jFsN2iomvx9iqsrGFTTkaW_p06bm8";

const nav = [
  ["Услуги", "#capabilities"],
  ["Парк", "#fleet"],
  ["Заявка", "#request"]
];

const heroStats = [
  ["До 100 тонн", "грузоподъемность"],
  ["Более 30 единиц", "собственной техники"],
  ["15 минут", "среднее время расчета"],
  ["Вся территория РФ", "география перевозок"]
];

const cargoTypes = [
  "спецтехника",
  "горнодобывающее и золотодобывающее оборудование",
  "запчасти и металлоконструкции",
  "вагон-дома и контейнеры",
  "сэндвич-панели и стройматериалы",
  "продукты и коммерческие грузы"
];

const serviceCards = [
  [
    "Предоставление спецтехники в любом регионе РФ",
    "Экскаваторы, автокраны, манипуляторы, бульдозеры, погрузчики и другая спецтехника."
  ],
  [
    "Доставка грузов в труднодоступные регионы и на месторождения",
    "Работаем по сложным направлениям: Таксимо, Бодайбо, Ленск, Якутск, Магадан и другие удаленные регионы."
  ],
  [
    "Организация мультимодальных перевозок",
    "Перевозим грузы несколькими видами транспорта: авто, ж/д, морским и авиа - по единому договору."
  ],
  [
    "Перевозка спецтехники и тяжелых грузов до 100 тонн",
    "Подбираем транспортное средство под ваш запрос в любом регионе РФ."
  ],
  [
    "Доставка сборных грузов от 400 кг",
    "Перевозка тентованными и бортовыми полуприцепами по всей территории РФ."
  ],
  [
    "Предоставление полного пакета документов по каждой перевозке",
    "Закрывающие документы, договоры и сопроводительная документация по каждой заявке."
  ]
];

const fleet = [
  ["Трал", "Для спецтехники, тяжелого оборудования и негабарита."],
  ["Тент", "Для закрытой перевозки грузов, которым нужна защита от погоды."],
  ["Борт", "Для строительных материалов, металлоконструкций и паллет."],
  ["Площадка", "Для крупногабаритных грузов и нестандартной погрузки."],
  ["Рефрижератор", "Для грузов с температурными требованиями."]
];

const gallery = [
  {
    src: withBase("/assets/rutrans-loader-black-truck.jpg"),
    alt: "Перевозка крупного погрузчика на низкорамном трале",
    title: "Спецтехника на трале"
  },
  {
    src: withBase("/assets/rutrans-excavator-tral-winter.jpg"),
    alt: "Экскаватор LiuGong на трале зимой",
    title: "Экскаваторы и техника"
  },
  {
    src: withBase("/assets/rutrans-module-winter.jpg"),
    alt: "Перевозка вагон-дома и модульного груза зимой",
    title: "Вагон-дома и модули"
  },
  {
    src: withBase("/assets/rutrans-night-loader-crane.jpg"),
    alt: "Ночная погрузка тяжелой техники с краном",
    title: "Сложная погрузка"
  },
  {
    src: withBase("/assets/rutrans-forklifts-inside-truck.jpg"),
    alt: "Погрузчики закреплены внутри тентованного транспорта",
    title: "Тентованные перевозки"
  },
  {
    src: withBase("/assets/rutrans-tank-tral.jpg"),
    alt: "Перевозка крупной промышленной емкости на трале",
    title: "Промышленное оборудование"
  }
];

const partners = [
  { src: withBase("/assets/partner-ura-mash.jpeg"), name: "Уралмаш" },
  { src: withBase("/assets/partner-techservice.jpeg"), name: "Техсервис" },
  { src: withBase("/assets/partner-evrokara-eurasia.jpeg"), name: "Еврокара Евразия" },
  { src: withBase("/assets/partner-gv-gold.jpeg"), name: "GV Gold" },
  { src: withBase("/assets/partner-stroykomplekt.jpeg"), name: "Стройкомплект" },
  { src: withBase("/assets/partner-dali.jpeg"), name: "Дали" },
  { src: withBase("/assets/partner-gazprom.jpeg"), name: "Газпром" },
  { src: withBase("/assets/partner-zolotomash.jpeg"), name: "Золотомаш" },
  { src: withBase("/assets/partner-lstk-group.jpeg"), name: "LSTK Group" },
  { src: withBase("/assets/partner-liugong-machinery.jpeg"), name: "LiuGong Машинери" },
  { src: withBase("/assets/partner-oilteam.jpeg"), name: "Ойлтим" },
  { src: withBase("/assets/partner-polyus.jpeg"), name: "Полюс" }
];

const details = [
  ["Полное наименование", company.fullName],
  ["ИНН / ОГРН / КПП", `${company.inn} / ${company.ogrn} / ${company.kpp}`],
  ["Адрес", company.address],
  ["Директор", company.director],
  ["Телефон", company.phonePretty],
  ["Доп. телефон", company.secondPhonePretty],
  ["Email", company.email],
  ["Доп. email", company.secondEmail],
  ["Часы звонков", company.workingHours]
];

const schema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: company.shortName,
  legalName: company.fullName,
  taxID: company.inn,
  identifier: [{ "@type": "PropertyValue", name: "ОГРН", value: company.ogrn }],
  url: siteUrl,
  email: company.email,
  telephone: [company.phoneRaw, company.secondPhoneRaw],
  address: {
    "@type": "PostalAddress",
    postalCode: "660077",
    addressRegion: "Красноярский край",
    addressLocality: "Красноярск",
    streetAddress: "ул. Батурина, д. 36А, помещ. 25, офис 52-4Б"
  },
  areaServed: "Российская Федерация",
  description,
  makesOffer: cargoTypes.map((name) => ({
    "@type": "Offer",
    itemOffered: {
      "@type": "Service",
      name: `Перевозка: ${name}`
    }
  }))
};
---

<BaseLayout title={title} description={description} siteUrl={siteUrl}>
  <a class="skip-link" href="#main">К содержанию</a>

  <header class="nav">
    <div class="site-shell nav-inner">
      <a class="brand" href={withBase("/")} aria-label="РУТРАНС">
        <img class="brand-mark" src={withBase("/assets/rutrans-symbol.svg")} alt="" width="230" height="150" />
        <span>РУТРАНС</span>
      </a>
      <nav class="nav-links" aria-label="Основная навигация">
        {nav.map(([label, href]) => (
          <a href={href}>{label}</a>
        ))}
      </nav>
      <div class="nav-actions">
        <a class="nav-cta" href={`tel:${company.phoneRaw}`}>{company.phonePretty}</a>
        <a class="nav-telegram" href="#request">Telegram</a>
        <a class="nav-telegram nav-max" href={maxUrl} target="_blank" rel="noreferrer">MAX</a>
      </div>
    </div>
  </header>

  <main id="main">
    <section class="hero">
      <img class="hero-bg" src={heroImage} alt="" loading="eager" decoding="async" />
      <div class="site-shell hero-content">
        <div class="hero-copy">
          <div class="hero-text">
            <p class="hero-subtitle">
              <span class="hero-line">Транспортная компания,</span>
              <span class="hero-line hero-wide-line">на которую можно положиться</span>
              <span class="hero-line hero-mobile-line">на которую можно</span>
              <span class="hero-line hero-mobile-line">положиться</span>
            </p>
            <p class="lead hero-offer">Получите расчёт стоимости перевозки груза за 15 минут</p>
          </div>
        </div>

        <div class="hero-panel">
          <div>
            <p class="eyebrow">Заявка</p>
            <h2>Быстрый расчёт стоимости</h2>
          </div>
          <form class="lead-form quick-form" action={leadAction} method="post" novalidate>
            <input type="hidden" name="name" value="Быстрый расчет" />
            <div class="quick-field">
              <label for="quick-route">Маршрут</label>
              <input
                id="quick-route"
                name="route"
                required
                minlength="3"
                maxlength="180"
                placeholder="Москва - Красноярск"
              />
            </div>
            <div class="quick-field">
              <label for="quick-cargo">Характер груза, габариты, вес</label>
              <input
                id="quick-cargo"
                name="cargo_details"
                required
                minlength="5"
                maxlength="500"
                placeholder="Погрузчик, 17 тонн, ДхШхВ: 8х3х3,5 м"
              />
            </div>
            <div class="quick-field">
              <label for="quick-phone">Имя, телефон или эл. почта</label>
              <input
                id="quick-phone"
                name="phone"
                autocomplete="tel"
                required
                minlength="6"
                maxlength="120"
                placeholder="Иван, +7 999 000 99 99"
              />
            </div>
            <label class="consent quick-consent">
              <input name="consent" value="yes" type="checkbox" required />
              <span>Согласен на обработку данных. <a href={privacyUrl}>Политика</a></span>
            </label>
            <div class="hidden-field" aria-hidden="true">
              <label for="quick-website">Сайт</label>
              <input id="quick-website" name="website" tabindex="-1" autocomplete="off" />
            </div>
            <button class="btn btn-primary" type="submit">Рассчитать</button>
            <p class="form-status" role="status" aria-live="polite"></p>
          </form>
          <dl class="quick-meta" aria-label="Ключевые показатели">
            {heroStats.map(([value, label]) => (
              <div>
                <dt>{value}</dt>
                <dd>{label}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <section class="service-hub" id="capabilities">
      <div class="site-shell service-hub-inner">
        <div class="section-head">
          <p class="eyebrow">Услуги</p>
          <h2>Услуги, которые предоставляет ООО «РУТРАНС»</h2>
        </div>
        <div class="service-card-grid">
          {serviceCards.map(([name, text]) => (
            <article class="service-card">
              <span class="service-check" aria-hidden="true"></span>
              <h3>{name}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="partners-section" aria-labelledby="partners-title">
      <div class="site-shell partners-shell">
        <div class="partners-head">
          <h2 id="partners-title">Наши партнеры</h2>
        </div>
        <div class="partners-grid" aria-label="Партнеры РУТРАНС">
          {partners.map((partner) => (
            <figure class="partner-card">
              <img src={partner.src} alt={partner.name} width="420" height="210" loading="lazy" decoding="async" />
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="site-shell section fleet-section" id="fleet">
      <div class="section-head">
        <h2>Парк нашей техники</h2>
      </div>
      <div class="fleet-grid">
        {fleet.map(([name, text]) => (
          <article class="fleet-card">
            <h3>{name}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="gallery-section" aria-labelledby="gallery-title">
      <div class="site-shell section-head">
        <h2 id="gallery-title">Примеры наших работ</h2>
      </div>
      <div class="gallery-grid">
        {gallery.map((item) => (
          <figure>
            <img src={item.src} alt={item.alt} width="1280" height="900" loading="lazy" decoding="async" />
            <figcaption>{item.title}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="site-shell section request-section" id="request">
      <div class="hero-panel request-quick-card">
        <p class="eyebrow">Заявка</p>
        <h2>Быстрый расчёт стоимости</h2>
        <form class="lead-form quick-form" action={leadAction} method="post" novalidate>
          <input type="hidden" name="name" value="Быстрый расчет" />
          <div class="quick-field">
            <label for="request-route">Маршрут</label>
            <input
              id="request-route"
              name="route"
              required
              minlength="3"
              maxlength="180"
              placeholder="Москва - Красноярск"
            />
          </div>
          <div class="quick-field">
            <label for="request-cargo">Характер груза, габариты, вес</label>
            <input
              id="request-cargo"
              name="cargo_details"
              required
              minlength="5"
              maxlength="500"
              placeholder="Погрузчик, 17 тонн, ДхШхВ: 8х3х3,5 м"
            />
          </div>
          <div class="quick-field">
            <label for="request-phone">Имя, телефон или эл. почта</label>
            <input
              id="request-phone"
              name="phone"
              autocomplete="tel"
              required
              minlength="6"
              maxlength="120"
              placeholder="Иван, +7 999 000 99 99"
            />
          </div>
          <label class="consent quick-consent">
            <input name="consent" value="yes" type="checkbox" required />
            <span>Согласен на обработку данных. <a href={privacyUrl}>Политика</a></span>
          </label>
          <div class="hidden-field" aria-hidden="true">
            <label for="request-website">Сайт</label>
            <input id="request-website" name="website" tabindex="-1" autocomplete="off" />
          </div>
          <button class="btn btn-primary" type="submit">Рассчитать</button>
          <p class="form-status" role="status" aria-live="polite"></p>
        </form>
        <dl class="quick-meta" aria-label="Ключевые показатели">
          {heroStats.map(([value, label]) => (
            <div>
              <dt>{value}</dt>
              <dd>{label}</dd>
            </div>
          ))}
        </dl>
      </div>

      <aside class="details-card" id="details" aria-label="Реквизиты компании">
        <div class="details-head">
          <h2>Контакты и реквизиты</h2>
        </div>
        {details.map(([label, value]) => (
          <div class="detail-block">
            <span>{label}</span>
            {label === "Телефон" ? (
              <a href={`tel:${company.phoneRaw}`}>{value}</a>
            ) : label === "Доп. телефон" ? (
              <a href={`tel:${company.secondPhoneRaw}`}>{value}</a>
            ) : label === "Email" ? (
              <a href={`mailto:${company.email}`}>{value}</a>
            ) : label === "Доп. email" ? (
              <a href={`mailto:${company.secondEmail}`}>{value}</a>
            ) : (
              <strong>{value}</strong>
            )}
          </div>
        ))}
        <a class="map-link" href={mapUrl} target="_blank" rel="noreferrer">Открыть точку на Яндекс.Картах</a>
      </aside>
    </section>
  </main>

  <footer class="footer">
    <div class="site-shell footer-inner">
      <p>{company.shortName}. ИНН {company.inn}. ОГРН {company.ogrn}.</p>
      <div>
        <a href={`tel:${company.phoneRaw}`}>{company.phonePretty}</a>
        <a href={`tel:${company.secondPhoneRaw}`}>{company.secondPhonePretty}</a>
        <a href={`mailto:${company.email}`}>{company.email}</a>
      </div>
    </div>
  </footer>

  <div class="mobile-bar" aria-label="Быстрые контакты">
    <a href={`tel:${company.phoneRaw}`}>Позвонить</a>
    <a href="#request">Заявка</a>
  </div>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  <script>
    const forms = document.querySelectorAll(".lead-form");
    const mobileBar = document.querySelector(".mobile-bar");
    const hero = document.querySelector(".hero");

    if (mobileBar instanceof HTMLElement && hero instanceof HTMLElement) {
      const syncMobileBar = () => {
        mobileBar.dataset.visible = window.scrollY > hero.offsetHeight - 120 ? "true" : "false";
      };

      syncMobileBar();
      window.addEventListener("scroll", syncMobileBar, { passive: true });
      window.addEventListener("resize", syncMobileBar);
    }

    forms.forEach((form) => {
      const status = form.querySelector(".form-status");
      if (!(form instanceof HTMLFormElement) || !(status instanceof HTMLElement)) return;

      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        const submitButton = form.querySelector('button[type="submit"]');
        if (!(submitButton instanceof HTMLButtonElement)) return;
        const submitText = submitButton.textContent || "Отправить заявку";

        status.textContent = "";
        status.removeAttribute("data-state");

        if (!form.reportValidity()) {
          status.textContent = "Проверьте обязательные поля и согласие.";
          status.setAttribute("data-state", "error");
          return;
        }

        if (location.hostname.endsWith("github.io")) {
          status.textContent = "Демо на GitHub Pages: форма не отправляет заявку. Для связи используйте телефон или почту.";
          status.setAttribute("data-state", "error");
          return;
        }

        submitButton.disabled = true;
        submitButton.textContent = "Отправляем";

        try {
          const response = await fetch(form.action, {
            method: "POST",
            body: new FormData(form),
            headers: {
              Accept: "application/json"
            }
          });

          const data = await response.json().catch(() => ({}));

          if (!response.ok || data.ok !== true) {
            throw new Error(data.message || "request_failed");
          }

          form.reset();
          status.textContent = "Заявка отправлена. Менеджер ответит обычно в течение 15 минут.";
          status.setAttribute("data-state", "success");
        } catch {
          status.textContent = "Не удалось отправить заявку. Позвоните или отправьте письмо на почту.";
          status.setAttribute("data-state", "error");
        } finally {
          submitButton.disabled = false;
          submitButton.textContent = submitText;
        }
      });
    });
  </script>
</BaseLayout>
