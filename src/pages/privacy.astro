---
import BaseLayout from "../layouts/BaseLayout.astro";
import { company, siteUrl } from "../lib/site";

const title = "Политика обработки данных - ООО «РУТРАНС»";
const description = "Как ООО «РУТРАНС» использует данные из формы заявки на сайте.";
const homeUrl = `${import.meta.env.BASE_URL}`;
---

<BaseLayout title={title} description={description} siteUrl={siteUrl}>
  <main class="site-shell legal-page">
    <a class="back-link" href={homeUrl}>На главную</a>
    <p class="eyebrow">Данные формы</p>
    <h1>Политика обработки данных</h1>
    <p class="lead">
      Форма на сайте нужна только для ответа на транспортную заявку. Сайт не ведет клиентскую базу и не публикует
      отправленные данные.
    </p>

    <section class="legal-section">
      <h2>Какие данные отправляются</h2>
      <p>Имя, телефон, название компании при заполнении, описание маршрута и груза.</p>
    </section>

    <section class="legal-section">
      <h2>Зачем они нужны</h2>
      <p>Чтобы связаться с заявителем, уточнить детали перевозки и подготовить ответ по расчету.</p>
    </section>

    <section class="legal-section">
      <h2>Куда приходит заявка</h2>
      <p>
        Заявка отправляется на рабочую почту {company.email}. Для защиты от спама сайт временно хранит технический
        счетчик отправок по хешу IP-адреса.
      </p>
    </section>

    <section class="legal-section">
      <h2>Контакты</h2>
      <p>
        {company.shortName}, ИНН {company.inn}, {company.shortAddress}. Телефон:
        <a href={`tel:${company.phoneRaw}`}>{company.phonePretty}</a>.
      </p>
    </section>
  </main>
</BaseLayout>
